# Copy to .env and fill in. docker compose reads this file automatically.

# --- Database ---
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=ecommerce

# --- Security ---
# Required. Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- RustFS object storage ---
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
RUSTFS_BUCKET=ecommerce
# URL the browser uses to fetch images; the app itself talks to http://rustfs:9000 inside compose.
RUSTFS_PUBLIC_URL=http://localhost:9000

# --- Mail ---
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=no-reply@example.com
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false

# --- Stripe ---
STRIPE_SECRET_KEY=

# Seed demo data on startup: always | never
SQL_INIT_MODE=never
